{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration --timeout 60000",
    "test:concurrency": "bun test ./test/concurrency --timeout 120000",
    "test:all": "bun test --timeout 120000",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": [
    "@embedded-postgres/windows-x64"
  ]
}
